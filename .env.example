# Reference only: export these in your environment; no automatic .env loading.
CM_DEBUG=0
CM_SECRET_KEY=replace-with-a-long-random-secret
CM_ALLOWED_HOSTS=cm.example.com
CM_FRONTEND_URL=https://cm.example.com
# Neon connection string (private). Never commit a real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set only behind Render's HTTPS proxy.
CM_TRUST_RENDER_PROXY=1
# Only for a deliberate fake-data seed command, never on the trial service.
CM_ALLOW_DEMO_DATA=0
CM_EMAIL_BACKEND=core.email_backend.ResendEmailBackend
CM_RESEND_API_KEY=replace-with-private-sending-key
CM_FROM_EMAIL=CM <onboarding@resend.dev>
# Must exactly match your Resend account email when using resend.dev.
# This restricts recipients; it never redirects another user's verification token.
CM_RESEND_TEST_RECIPIENT=your-resend-account@example.com
