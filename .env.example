# Reference only: export these in your environment; no automatic .env loading.
CM_DEBUG=0
CM_SECRET_KEY=replace-with-a-long-random-secret
CM_ALLOWED_HOSTS=cm.example.com
CM_FRONTEND_URL=https://cm.example.com
# Neon connection string (private). Never commit a real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set only behind Render's HTTPS proxy.
CM_TRUST_RENDER_PROXY=1
# Only for a deliberate fake-data seed command, never on the trial service.
CM_ALLOW_DEMO_DATA=0
CM_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
CM_EMAIL_HOST=smtp.example.com
CM_EMAIL_PORT=587
CM_EMAIL_USER=replace-me
CM_EMAIL_PASSWORD=replace-me
CM_EMAIL_TLS=1
CM_FROM_EMAIL=CM <noreply@example.com>
